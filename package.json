{
  "name": "obix-compiler-emit",
  "version": "0.5.0",
  "description": "The OBIX compiler: source -> sections -> AST -> semantic AST -> canonical DOP IR -> ES6 emit. Accessibility analysis is a HARD dependency; there is no --no-a11y mode.",
  "license": "MIT",
  "author": "OBINexus Computing — Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "test",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "obix-compiler-a11y": "0.5.0",
    "obix-compiler-legacy-parser": "0.5.0",
    "obix-compiler-styles": "0.5.0",
    "obix-compiler-legacy-template": "0.5.0",
    "obix-compiler-validator": "0.5.0",
    "obix-core-spec": "0.5.0"
  },
  "devDependencies": {
    "obix-compiler-equivalence": "0.5.0"
  },
  "keywords": [
    "obix"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/obix-compiler-emit.git"
  },
  "bugs": {
    "url": "https://github.com/obinexus/obix-compiler-emit/issues"
  },
  "homepage": "https://github.com/obinexus/obix-compiler-emit#readme"
}
